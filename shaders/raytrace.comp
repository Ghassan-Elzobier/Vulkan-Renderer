#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1, rgba32f) uniform image2D accumImage;

layout(push_constant) uniform PushConstants {
    uint frameCount;
} pc;

const int LAMBERTIAN = 0;
const int METAL = 1;

struct HitRecord {
    bool didHit;
    float t;
    vec3 point;
    vec3 normal;
    vec3 albedo;
    int material;
    float fuzz;
};

uint seed;

uint pcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomFloat() {
    seed = pcgHash(seed);
    return float(seed) / 4294967296.0;
}

float randomFloatRange(float lo, float hi) {
    return lo + (hi - lo) * randomFloat();
}

vec3 randomUnitVector() {
    for (int i = 0; i < 16; i++) {
        vec3 p = vec3(randomFloatRange(-1.0, 1.0),
                      randomFloatRange(-1.0, 1.0),
                      randomFloatRange(-1.0, 1.0));
        float lenSq = dot(p, p);
        if (lenSq > 0.0001 && lenSq <= 1.0) {
            return p / sqrt(lenSq);
        }
    }
    return vec3(0.0, 1.0, 0.0);
}

vec3 skyColor(vec3 direction) {
    float t = 0.5 * (direction.y + 1.0);
    return mix(vec3(1.0), vec3(0.5, 0.7, 1.0), t);
}

HitRecord hitSphere(vec3 origin, vec3 direction, vec3 center, float radius,
                    vec3 albedo, int material, float fuzz) {
    HitRecord rec;
    rec.didHit = false;
    rec.t = 0.0;
    rec.point = vec3(0.0);
    rec.normal = vec3(0.0);
    rec.albedo = albedo;
    rec.material = material;
    rec.fuzz = fuzz;

    vec3 oc = origin - center;
    float a = dot(direction, direction);
    float b = 2.0 * dot(oc, direction);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = b * b - 4.0 * a * c;

    if (discriminant < 0.0) {
        return rec;
    }

    float t = (-b - sqrt(discriminant)) / (2.0 * a);
    if (t <= 0.001) {
        return rec;
    }

    rec.didHit = true;
    rec.t = t;
    rec.point = origin + t * direction;
    rec.normal = normalize(rec.point - center);
    return rec;
}

HitRecord hitScene(vec3 origin, vec3 direction) {
    HitRecord closest;
    closest.didHit = false;
    closest.t = 1e30;

    HitRecord candidate;

    candidate = hitSphere(origin, direction,
        vec3(0.0, 0.4, -2.0), 0.9, vec3(0.913, 0.921, 0.925) , METAL, 0.01);
    if (candidate.didHit && candidate.t < closest.t) closest = candidate;

    candidate = hitSphere(origin, direction,
        vec3(-0.6, -0.28, -1.0), 0.22, vec3(0.8, 0.25, 0.25), LAMBERTIAN, 0.0);
    if (candidate.didHit && candidate.t < closest.t) closest = candidate;

    candidate = hitSphere(origin, direction,
        vec3(0.55, -0.32, -0.85), 0.18, vec3(0.85, 0.65, 0.2), METAL, 0.3);
    if (candidate.didHit && candidate.t < closest.t) closest = candidate;

    candidate = hitSphere(origin, direction,
        vec3(0.0, -100.5, -1.0), 100.0, vec3(0.5, 0.5, 0.5), LAMBERTIAN, 0.0);
    if (candidate.didHit && candidate.t < closest.t) closest = candidate;

    return closest;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    seed = pcgHash(uint(pixel.x) + uint(pixel.y) * uint(size.x) + pc.frameCount * 719393u);

    vec2 jitter = vec2(randomFloat(), randomFloat());
    vec2 uv = (vec2(pixel) + jitter) / vec2(size);
    uv = uv * 2.0 - 1.0;
    uv.x *= float(size.x) / float(size.y);

    vec3 rayOrigin = vec3(0.0, 0.0, 0.0);
    vec3 rayDirection = normalize(vec3(uv.x, -uv.y, -1.0));

    vec3 color = vec3(1.0);

    for (int bounce = 0; bounce < 8; bounce++) {
        HitRecord hit = hitScene(rayOrigin, rayDirection);

        if (!hit.didHit) {
            color *= skyColor(rayDirection);
            break;
        }

        color *= hit.albedo;
        rayOrigin = hit.point;

        if (hit.material == LAMBERTIAN) {
            rayDirection = normalize(hit.normal + randomUnitVector());
        } else {
            rayDirection = normalize(reflect(rayDirection, hit.normal)
                                     + hit.fuzz * randomUnitVector());
        }
    }

    vec3 accumulated = color;
    if (pc.frameCount > 0u) {
        accumulated += imageLoad(accumImage, pixel).rgb;
    }
    imageStore(accumImage, pixel, vec4(accumulated, 1.0));

    vec3 averaged = accumulated / float(pc.frameCount + 1u);
    averaged = sqrt(averaged);

    imageStore(outputImage, pixel, vec4(averaged, 1.0));
}
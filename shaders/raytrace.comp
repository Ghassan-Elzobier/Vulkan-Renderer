#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1, rgba32f) uniform image2D accumImage;

// The triangle scene, uploaded by the CPU (src/scene/mesh.h has the matching C++ structs).
// std430: a vec3 is 16-byte aligned but 12 bytes long, so the uint after it fills the gap.
struct Triangle {
    vec3 v0;
    uint material;
    vec3 v1;
    float pad1;
    vec3 v2;
    float pad2;
};

struct Material {
    vec3 albedo;
    float fuzz;
    uint type;
    uint pad0;
    uint pad1;
    uint pad2;
};

layout(std430, binding = 2) readonly buffer Triangles { Triangle triangles[]; };
layout(std430, binding = 3) readonly buffer Materials { Material materials[]; };

struct Sphere {
    vec3 center;
    float radius;
    uint material;
    uint pad0;
    uint pad1;
    uint pad2;
};

layout(std430, binding = 4) readonly buffer Spheres { Sphere spheres[]; };

layout(push_constant) uniform PushConstants {
    uint frameCount;
} pc;

const uint SCENE_SPHERES = 0u;
const uint SCENE_GRID = 1u;
const uint SCENE_TRIANGLES = 2u;

// Which kind of geometry to trace: spheres (scenes 0 and 1, which differ only in the buffer the
// CPU uploads) or triangles (scene 2). A specialization constant, not a push constant: its value
// is fixed when the pipeline is created, so the compiler deletes the other loop entirely. As a
// push constant an unused loop once cost the spheres scene 3.5% on the 5700 XT.
layout(constant_id = 0) const uint SCENE = SCENE_SPHERES;

const int LAMBERTIAN = 0;
const int METAL = 1;

struct HitRecord {
    bool didHit;
    float t;
    vec3 point;
    vec3 normal;
    vec3 albedo;
    int material;
    float fuzz;
};

uint seed;

uint pcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomFloat() {
    seed = pcgHash(seed);
    return float(seed) / 4294967296.0;
}

float randomFloatRange(float lo, float hi) {
    return lo + (hi - lo) * randomFloat();
}

vec3 randomUnitVector() {
    for (int i = 0; i < 16; i++) {
        vec3 p = vec3(randomFloatRange(-1.0, 1.0),
                      randomFloatRange(-1.0, 1.0),
                      randomFloatRange(-1.0, 1.0));
        float lenSq = dot(p, p);
        if (lenSq > 0.0001 && lenSq <= 1.0) {
            return p / sqrt(lenSq);
        }
    }
    return vec3(0.0, 1.0, 0.0);
}

vec3 skyColor(vec3 direction) {
    float t = 0.5 * (direction.y + 1.0);
    return mix(vec3(1.0), vec3(0.5, 0.7, 1.0), t);
}

// Scenes 0 and 1: spheres from the storage buffer (the CPU builds them, src/scene/mesh.cpp),
// every ray against every sphere. A sphere is all points `radius` from `center`; putting the
// ray origin + t*direction into that rule gives a quadratic in t, and the smaller root is
// where the ray enters.
HitRecord hitSpheres(vec3 origin, vec3 direction) {
    HitRecord closest;
    closest.didHit = false;
    closest.t = 1e30;
    uint closestIndex = 0u;

    uint count = uint(spheres.length());
    for (uint i = 0u; i < count; i++) {
        vec3 oc = origin - spheres[i].center;
        float radius = spheres[i].radius;
        float a = dot(direction, direction);
        float b = 2.0 * dot(oc, direction);
        float c = dot(oc, oc) - radius * radius;
        float discriminant = b * b - 4.0 * a * c;
        if (discriminant < 0.0) continue;
        float t = (-b - sqrt(discriminant)) / (2.0 * a);
        if (t > 0.001 && t < closest.t) {
            closest.didHit = true;
            closest.t = t;
            closestIndex = i;
        }
    }

    // Shade only the winner, as hitTriangles does.
    if (closest.didHit) {
        closest.point = origin + closest.t * direction;
        closest.normal = normalize(closest.point - spheres[closestIndex].center);
        Material m = materials[spheres[closestIndex].material];
        closest.albedo = m.albedo;
        closest.material = int(m.type);
        closest.fuzz = m.fuzz;
    }
    return closest;
}

// Scene 2: triangles from the storage buffers, every ray against every triangle (brute force).
// Moller-Trumbore: solve origin + t*direction = v0 + u*e1 + v*e2 for (t, u, v) with Cramer's
// rule; the ray hits when u >= 0, v >= 0 and u + v <= 1. Same maths as intersectTriangle in
// src/scene/bvh.cpp, so the CPU check and the GPU agree.
HitRecord hitTriangles(vec3 origin, vec3 direction) {
    HitRecord closest;
    closest.didHit = false;
    closest.t = 1e30;
    uint closestIndex = 0u;

    uint count = uint(triangles.length());
    for (uint i = 0u; i < count; i++) {
        vec3 v0 = triangles[i].v0;
        vec3 e1 = triangles[i].v1 - v0;
        vec3 e2 = triangles[i].v2 - v0;
        vec3 p = cross(direction, e2);
        float det = dot(e1, p);
        if (abs(det) < 1e-8) continue;
        float invDet = 1.0 / det;
        vec3 s = origin - v0;
        float u = dot(s, p) * invDet;
        if (u < 0.0 || u > 1.0) continue;
        vec3 q = cross(s, e1);
        float v = dot(direction, q) * invDet;
        if (v < 0.0 || u + v > 1.0) continue;
        float t = dot(e2, q) * invDet;
        if (t > 0.001 && t < closest.t) {
            closest.didHit = true;
            closest.t = t;
            closestIndex = i;
        }
    }

    // Shade only the winner: one normal and one material read per ray, not per hit.
    if (closest.didHit) {
        Triangle tri = triangles[closestIndex];
        vec3 n = normalize(cross(tri.v1 - tri.v0, tri.v2 - tri.v0));
        // A triangle has two sides. Face the normal towards the ray, so a bounce leaves
        // on the side the ray came from, whichever way the triangle was wound.
        closest.normal = dot(n, direction) > 0.0 ? -n : n;
        closest.point = origin + closest.t * direction;
        Material m = materials[tri.material];
        closest.albedo = m.albedo;
        closest.material = int(m.type);
        closest.fuzz = m.fuzz;
    }
    return closest;
}

HitRecord hitScene(vec3 origin, vec3 direction) {
    return SCENE == SCENE_TRIANGLES ? hitTriangles(origin, direction) : hitSpheres(origin, direction);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    seed = pcgHash(uint(pixel.x) + uint(pixel.y) * uint(size.x) + pc.frameCount * 719393u);

    vec2 jitter = vec2(randomFloat(), randomFloat());
    vec2 uv = (vec2(pixel) + jitter) / vec2(size);
    uv = uv * 2.0 - 1.0;
    uv.x *= float(size.x) / float(size.y);

    vec3 rayOrigin = vec3(0.0, 0.0, 0.0);
    vec3 rayDirection = normalize(vec3(uv.x, -uv.y, -1.0));

    vec3 color = vec3(1.0);

    for (int bounce = 0; bounce < 8; bounce++) {
        HitRecord hit = hitScene(rayOrigin, rayDirection);

        if (!hit.didHit) {
            color *= skyColor(rayDirection);
            break;
        }

        color *= hit.albedo;
        rayOrigin = hit.point;

        if (hit.material == LAMBERTIAN) {
            rayDirection = normalize(hit.normal + randomUnitVector());
        } else {
            rayDirection = normalize(reflect(rayDirection, hit.normal)
                                     + hit.fuzz * randomUnitVector());
        }
    }

    vec3 accumulated = color;
    if (pc.frameCount > 0u) {
        accumulated += imageLoad(accumImage, pixel).rgb;
    }
    imageStore(accumImage, pixel, vec4(accumulated, 1.0));

    vec3 averaged = accumulated / float(pc.frameCount + 1u);
    averaged = sqrt(averaged);

    imageStore(outputImage, pixel, vec4(averaged, 1.0));
}